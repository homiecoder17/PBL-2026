<%
  const labels = {
    FCFS: 'ARRIVAL ORDER',
    SJF: 'SHORTEST READY JOB FIRST',
    SRTF: 'PREEMPTIVE SHORTEST REMAINING TIME',
    PRIORITY: 'PRIORITY ORDER (LOWER = HIGHER)',
    RR: `ROUND ROBIN · QUANTUM q = ${result.quantum ?? 2}`,
  };
  const canCommit = user && user.role === 'admin' && typeof source !== 'undefined' && (typeof nonPreemptiveAlgs === 'undefined' || nonPreemptiveAlgs.includes(result.algorithm));
%>
<section class="panel schedule-result alg-result-panel" data-alg-panel="<%= result.algorithm %>">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><%= labels[result.algorithm] || result.algorithm %></p>
      <h2><%= result.algorithm %>
        <% if (result.algorithm === 'SJF' || result.algorithm === 'PRIORITY') { %>
          <span class="muted subtitle">Non-preemptive</span>
        <% } else if (result.algorithm === 'SRTF' || result.algorithm === 'RR') { %>
          <span class="muted subtitle">Preemptive</span>
        <% } %>
      </h2>
    </div>
    <% if (typeof signedTokens !== 'undefined' && signedTokens && signedTokens[result.algorithm]) { %>
      <form method="post" action="/simulator/save">
        <input type="hidden" name="csrf_token" value="<%= csrf %>">
        <input type="hidden" name="input_token" value="<%= signedTokens[result.algorithm] %>">
        <button class="btn btn-outline-primary">Save <%= result.algorithm %> run</button>
      </form>
    <% } %>
  </div>

  <div class="result-metrics">
    <div><span>Average waiting time</span><strong><%= fixed(result.average_waiting_time) %> <small>units</small></strong></div>
    <div><span>Average turnaround time</span><strong><%= fixed(result.average_turnaround_time) %> <small>units</small></strong></div>
    <div><span>Average response time</span><strong><%= fixed(result.average_response_time ?? result.average_waiting_time) %> <small>units</small></strong></div>
    <div><span>CPU utilization</span><strong><%= fixed(result.cpu_utilization ?? 100) %><small>%</small></strong></div>
  </div>

  <h3 class="gantt-title">Execution timeline</h3>
  <p class="small-note">Simulated time units · widths are proportional to duration. Exact intervals are listed below.</p>
  <div class="gantt-track" role="img" aria-label="<%= result.algorithm + ' Gantt chart. ' + result.segments.map(s => s.process_id + ': ' + s.start + ' to ' + s.finish).join('. ') %>">
    <% for (const s of result.segments) { %>
      <div class="gantt-segment <%= s.process_id === 'IDLE' ? 'idle' : 'process-' + result.color_by_process[s.process_id] %>" style="width:<%= (s.finish - s.start) / result.total_time * 100 %>%" title="<%= s.process_id %>: <%= s.start %>–<%= s.finish %>">
        <% if ((s.finish - s.start) / result.total_time >= 0.08) { %>
          <strong><%= s.process_id %></strong><span><%= s.start %>–<%= s.finish %></span>
        <% } %>
      </div>
    <% } %>
  </div>
  <div class="gantt-axis"><span>0</span><span><%= result.total_time %> units</span></div>
  <ol class="timeline-key" aria-label="Execution order">
    <% for (const s of result.segments) { %>
      <li><strong><%= s.process_id %></strong> <span><%= s.start %>–<%= s.finish %></span></li>
    <% } %>
  </ol>

  <p class="table-scroll-hint">Scroll horizontally to view all columns.</p>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Scrollable data table">
    <table class="table results-table">
      <caption>CT = completion; TAT = CT − arrival; WT = TAT − burst; RT = first start − arrival.</caption>
      <thead>
        <tr>
          <th scope="col">Process</th>
          <th scope="col">Event Title</th>
          <th scope="col">Start Time (AT)</th>
          <th scope="col">Students (BT)</th>
          <th scope="col">Priority</th>
          <th scope="col">First Start</th>
          <th scope="col">CT</th>
          <th scope="col">WT</th>
          <th scope="col">TAT</th>
          <th scope="col">RT</th>
        </tr>
      </thead>
      <tbody>
        <% for (const r of result.rows) { %>
          <tr>
            <td class="font-mono"><strong><%= r.process_id %></strong></td>
            <td><%= r.task_name %></td>
            <td class="font-mono">
              <% if (r.original_start_time) { %>
                <strong><%= r.original_start_time %></strong> <small class="text-muted">(AT=<%= r.arrival_time %>)</small>
              <% } else { %>
                AT=<%= r.arrival_time %>
              <% } %>
            </td>
            <td class="font-mono">
              <% if (r.expected_students) { %>
                <strong><%= r.expected_students %></strong> <small class="text-muted">(BT=<%= r.burst_time %>h)</small>
              <% } else { %>
                BT=<%= r.burst_time %>h
              <% } %>
            </td>
            <td class="font-mono"><%= r.priority ?? 0 %></td>
            <td class="font-mono"><%= r.start_time %></td>
            <td class="font-mono"><%= r.finish_time %></td>
            <td class="font-mono"><strong><%= r.waiting_time %></strong></td>
            <td class="font-mono"><%= r.turnaround_time %></td>
            <td class="font-mono"><%= r.response_time ?? (r.start_time - r.arrival_time) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (canCommit) { %>
    <form method="post" action="/simulator/commit" class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
      <input type="hidden" name="csrf_token" value="<%= csrf %>">
      <input type="hidden" name="algorithm" value="<%= result.algorithm %>">
      <textarea name="workload" hidden style="display:none;"><%= source %></textarea>
      <input type="hidden" name="venue_id" value="<%= selectedVenueId %>">
      <input type="hidden" name="event_date" value="<%= selectedDate %>">
      <span class="small-note">Apply this non-preemptive <%= result.algorithm %> sequence to allocate non-conflicting slots in the database.</span>
      <button class="btn btn-primary">Commit <%= result.algorithm %> schedule to DB →</button>
    </form>
  <% } %>
</section>
