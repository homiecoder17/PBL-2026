<section class="panel schedule-result"><div class="section-heading"><div><p class="eyebrow"><%= result.algorithm==='FCFS'?'ARRIVAL ORDER':'SHORTEST READY JOB FIRST' %></p><h2><%= result.algorithm %><% if(result.algorithm==='SJF'){ %> <span class="muted subtitle">Non-preemptive</span><% } %></h2></div></div><div class="result-metrics"><div><span>Average waiting time</span><strong><%= fixed(result.average_waiting_time) %> <small>units</small></strong></div><div><span>Average turnaround time</span><strong><%= fixed(result.average_turnaround_time) %> <small>units</small></strong></div></div><h3 class="gantt-title">Execution timeline</h3><p class="small-note">Simulated time units · widths are proportional to duration. Exact intervals are listed below.</p><div class="gantt-track" role="img" aria-label="<%= result.algorithm+' Gantt chart. '+result.segments.map(s=>s.process_id+': '+s.start+' to '+s.finish).join('. ') %>"><% for(const s of result.segments){ %><div class="gantt-segment <%= s.process_id==='IDLE'?'idle':'process-'+result.color_by_process[s.process_id] %>" style="width:<%= (s.finish-s.start)/result.total_time*100 %>%" title="<%= s.process_id %>: <%= s.start %>–<%= s.finish %>"><% if((s.finish-s.start)/result.total_time>=0.1){ %><strong><%= s.process_id %></strong><span><%= s.start %>–<%= s.finish %></span><% } %></div><% } %></div><div class="gantt-axis"><span>0</span><span><%= result.total_time %> units</span></div><ol class="timeline-key" aria-label="Execution order"><% for(const s of result.segments){ %><li><strong><%= s.process_id %></strong> <span><%= s.start %>–<%= s.finish %></span></li><% } %></ol><p class="table-scroll-hint">Scroll horizontally to view all columns.</p><div class="table-responsive" tabindex="0" role="region" aria-label="Scrollable data table"><table class="table results-table"><caption>CT = completion; TAT = CT − arrival; WT = TAT − burst. All times in hours starting from 09:00 AM.</caption><thead><tr><th scope="col">Process</th><th scope="col">Event Title</th><th scope="col">Start Time (AT)</th><th scope="col">Students (BT)</th><th scope="col">Allocated Slot</th><th scope="col">Start</th><th scope="col">CT</th><th scope="col">WT</th><th scope="col">TAT</th></tr></thead><tbody><% for(const r of result.rows){ %><tr><td><strong><%= r.process_id %></strong></td><td><%= r.task_name %></td><td><% if(r.original_start_time){ %><strong><%= r.original_start_time %></strong> <small class="text-muted">(AT=<%= r.arrival_time %>)</small><% } else { %>AT=<%= r.arrival_time %><% } %></td><td><% if(r.expected_students){ %><strong><%= r.expected_students %></strong> <small class="text-muted">(BT=<%= r.burst_time %>h)</small><% } else { %>BT=<%= r.burst_time %>h<% } %></td><td><span class="badge bg-primary-subtle text-primary border"><%= String(9 + r.start_time).padStart(2, '0') %>:00 – <%= String(9 + r.finish_time).padStart(2, '0') %>:00</span></td><td><%= r.start_time %></td><td><%= r.finish_time %></td><td><%= r.waiting_time %></td><td><%= r.turnaround_time %></td></tr><% } %></tbody></table></div><form method="post" action="/simulator/commit" class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2"><input type="hidden" name="csrf_token" value="<%= csrf %>"><input type="hidden" name="algorithm" value="<%= result.algorithm %>"><textarea name="workload" hidden style="display:none;"><%- source %></textarea><input type="hidden" name="venue_id" value="<%= selectedVenueId %>"><input type="hidden" name="event_date" value="<%= selectedDate %>"><span class="small-note">Apply this <%= result.algorithm %> sequence to allocate non-conflicting slots in MySQL.</span><button class="btn btn-primary">Commit <%= result.algorithm %> schedule to MySQL →</button></form></section>