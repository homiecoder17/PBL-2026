<%- include('partials/header',{title:'Overview',active:'dashboard'}) %>
<% const isAdmin = user.role === 'admin'; const isFaculty = user.role === 'faculty'; %>
<section class="overview-hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="overview-copy">
    <div class="live-pill mb-3">
      <span class="live-beacon" aria-hidden="true"></span>
      <span><%= isAdmin ? 'Administrator Console' : (isFaculty ? 'Faculty Portal Live' : 'Campus Hub Live') %></span>
    </div>
    <h1 class="split-heading"><span>Your campus.</span><span>In one <em>place.</em></span></h1>
    <p>Welcome, <%= user.name %>. <%= isAdmin ? 'Coordinate campus halls, venue requests, registrations, and conflict-free schedules in real time.' : (isFaculty ? 'Register new campus events, join the hall assignment queue, and inspect student registrations.' : 'Discover upcoming campus events, reserve your seats, and keep track of your passes.') %></p>
    <div class="d-flex gap-2 flex-wrap">
      <% if (isAdmin) { %>
        <a class="btn btn-hero" href="/events/new">+ Create event <%- include('partials/icon',{name:'arrow'}) %></a>
        <a class="btn btn-hero-ghost" href="/venues/assign">Venue portal (<%= stats.queuedRequests %>)</a>
      <% } else if (isFaculty) { %>
        <a class="btn btn-hero" href="/faculty/events/new">+ Register event <%- include('partials/icon',{name:'arrow'}) %></a>
        <a class="btn btn-hero-ghost" href="/faculty">Open faculty hub</a>
      <% } else { %>
        <a class="btn btn-hero" href="/events">Browse events <%- include('partials/icon',{name:'arrow'}) %></a>
        <a class="btn btn-hero-ghost" href="/registrations">My registrations</a>
      <% } %>
    </div>
  </div>
  <div class="overview-next">
    <div class="next-top">
      <span class="next-badge">NEXT ON CAMPUS</span>
      <% if (upcoming.length) { const next = upcoming[0]; %>
        <span class="next-when-tag"><%= dateMonth(next.event_date).toUpperCase() %> <%= dateDay(next.event_date) %> · <%= clock(next.start_time) %></span>
      <% } else { %>
        <%- include('partials/icon',{name:'calendar'}) %>
      <% } %>
    </div>
    <% if (upcoming.length) {
         const next = upcoming[0];
         const nextReg = Number(next.registration_count || 0);
         const nextMax = Number(next.expected_attendance || 1);
         const nextPct = Math.min(100, Math.round((nextReg / nextMax) * 100));
         const seatsLeft = Math.max(0, nextMax - nextReg);
    %>
      <h2><%= next.title %></h2>
      <p class="next-venue"><%- include('partials/icon',{name:'pin'}) %> <span><%= next.venue_name %> · <%= clock(next.start_time) %>–<%= clock(next.end_time) %></span></p>
      <div class="next-capacity">
        <div class="next-capacity-meta">
          <span>Venue seating</span>
          <strong><%= seatsLeft %> seats left</strong>
        </div>
        <div class="next-capacity-bar" aria-hidden="true"><span style="width:<%= nextPct %>%"></span></div>
      </div>
      <a href="/events" class="next-link">Explore campus events <%- include('partials/icon',{name:'arrow'}) %></a>
    <% } else { %>
      <h2>Your next great event<br>starts here.</h2>
      <p>No upcoming events scheduled yet.</p>
      <a href="/events" class="next-link">Open events <%- include('partials/icon',{name:'arrow'}) %></a>
    <% } %>
  </div>
</section>

<div class="metric-grid">
  <%
    const metrics = isAdmin
      ? [
          ['Scheduled events', stats.events, 'Active campus events', 'calendar', '/events'],
          ['Venue queue', stats.queuedRequests || 0, stats.queuedRequests ? 'Faculty halls awaiting assignment' : `${stats.venues} campus halls ready`, 'pin', stats.queuedRequests ? '/venues/assign' : '/venues'],
          ['Saved OS runs', stats.runs, '5 scheduling models', 'cpu', '/runs'],
          ['Database engine', dbFallback ? 'SQLite' : 'MySQL 8', dbFallback ? 'Offline relational fallback' : 'InnoDB ACID connected', 'lock', '/reports'],
        ]
      : isFaculty
        ? [
            ['My events', stats.myEvents, 'Events organized by you', 'calendar', '/faculty'],
            ['In venue queue', stats.queuedRequests, 'Awaiting hall confirmation', 'clock', '/faculty'],
            ['Assigned venues', stats.assignedRequests, 'Confirmed & open for registration', 'building', '/faculty'],
            ['Total attendees', stats.totalAttendees, 'Confirmed student registrations', 'users', '/events'],
          ]
        : [
            ['Upcoming events', stats.events, 'Open across campus', 'calendar', '/events'],
            ['My registrations', stats.registrations, stats.waitlisted ? `${stats.waitlisted} waitlisted` : 'Confirmed campus passes', 'ticket', '/registrations'],
            ['Campus venues', stats.venues, 'Auditoriums & student hubs', 'pin', '/events'],
            ['Campus pass', 'Active', 'Ready for event entry', 'check', '/registrations'],
          ];
    for (const m of metrics) {
  %>
    <a href="<%= m[4] %>" class="panel metric text-decoration-none">
      <div class="metric-top"><span><%= m[0] %></span><span class="metric-icon"><%- include('partials/icon',{name:m[3]}) %></span></div>
      <strong><%= m[1] %></strong>
      <small><%= m[2] %></small>
    </a>
  <% } %>
</div>

<section class="panel calendar-shell mb-4">
  <div class="calendar-split">
    <div class="calendar-main">
      <div class="section-heading d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
          <p class="eyebrow">MONTHLY EVENT CALENDAR</p>
          <h2>Interactive campus schedule<span class="heading-period">.</span></h2>
          <p class="muted mb-0"><%= isAdmin ? 'Click any date to inspect events and launch the OS CPU scheduler.' : (isFaculty ? 'Click any date to preview campus events or register a new event on that day.' : 'Click any date to preview scheduled campus events and seat availability.') %></p>
        </div>
        <div class="calendar-controls d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="cal-prev">&larr; Prev</button>
          <span class="fw-bold px-2" id="cal-month-year"></span>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="cal-next">Next &rarr;</button>
        </div>
      </div>

      <div class="calendar-grid-header">
        <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
      </div>
      <div class="calendar-grid" id="calendar-days"></div>
    </div>

    <aside class="calendar-drawer" id="selected-date-card" style="display:none;">
      <div class="calendar-drawer-head">
        <div>
          <p class="eyebrow m-0 text-primary">SELECTED DATE</p>
          <h3 class="m-0" id="sel-date-label"></h3>
        </div>
      </div>
      <div id="sel-date-events" class="calendar-drawer-events"></div>
      <div class="calendar-drawer-actions" id="sel-date-actions"></div>
    </aside>
  </div>
</section>

<div class="dashboard-grid">
  <section class="panel upcoming-panel">
    <div class="section-heading"><div><p class="eyebrow">THE CAMPUS CALENDAR</p><h2>Coming up next.</h2></div><a href="/events">View all <span aria-hidden="true">↗</span></a></div>
    <% for (const e of upcoming) { %>
      <article class="event-mini">
        <div class="date-badge"><span><%= dateMonth(e.event_date) %></span><strong><%= dateDay(e.event_date) %></strong></div>
        <div>
          <h3><%= e.title %></h3>
          <p><%= e.venue_name %> · <%= clock(e.start_time) %>–<%= clock(e.end_time) %></p>
          <small><%= Number(e.registration_count || 0) %> / <%= e.expected_attendance %> seats reserved</small>
        </div>
        <a class="event-mini-link" href="/events" aria-label="Browse <%= e.title %>"><%- include('partials/icon',{name:'arrow'}) %></a>
      </article>
    <% } if (!upcoming.length) { %>
      <p class="empty-state">No upcoming events yet.</p>
    <% } %>
  </section>

  <% if (isAdmin) { %>
    <section class="panel learning-panel">
      <div class="lab-heading"><span class="lab-symbol"><%- include('partials/icon',{name:'cpu'}) %></span><span class="eyebrow">THE OS SANDBOX</span></div>
      <h2>Small processes.<br>Big insights.</h2>
      <p>One workload. Five strategies. Compare FCFS, non-preemptive SJF, SRTF, Priority, and Round Robin side by side.</p>
      <div class="lab-flow" aria-label="Simulation workflow"><span>01<br><strong>Arrive</strong></span><span aria-hidden="true">→</span><span>02<br><strong>Execute</strong></span><span aria-hidden="true">→</span><span>03<br><strong>Measure</strong></span></div>
      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="/simulator">Open OS Scheduler <%- include('partials/icon',{name:'arrow'}) %></a>
        <a class="btn btn-outline-primary" href="/venues/assign">Venue Portal (<%= stats.queuedRequests || 0 %>)</a>
      </div>
      <div class="notice">The OS CPU scheduler sequences events without collisions and commits non-overlapping time slots to the database.</div>
    </section>
  <% } else if (isFaculty) { %>
    <section class="panel campus-pass-panel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FACULTY VENUE QUEUE</p>
          <h2>Hall requests.</h2>
        </div>
        <a href="/faculty">Open hub ↗</a>
      </div>
      <% if (myQueueRequests && myQueueRequests.length) { %>
        <div class="pass-list mt-2">
          <% for (const qr of myQueueRequests) { const rank = queueRanks.get(qr.request_id); %>
            <div class="pass-list-item">
              <div>
                <strong><%= qr.title %></strong>
                <small><%= displayDate(qr.event_date) %> · <%= clock(qr.start_time) %>–<%= clock(qr.end_time) %> · <%= qr.event_size %> seats</small>
                <% if (qr.queue_status === 'assigned' && qr.assigned_venue_name) { %>
                  <small class="d-block text-success fw-semibold">Assigned: <%= qr.assigned_venue_name %></small>
                <% } else if (qr.queue_status === 'queued' && rank) { %>
                  <small class="d-block muted">Queue #<%= rank.position %> of <%= rank.total %><%= qr.preferred_venue_name ? ` · Prefers ${qr.preferred_venue_name}` : '' %></small>
                <% } %>
              </div>
              <span class="status <%= qr.queue_status === 'assigned' ? 'status-green' : (qr.queue_status === 'queued' ? 'status-amber' : 'status-gray') %>">
                <%= qr.queue_status === 'assigned' ? 'Assigned' : (qr.queue_status === 'queued' ? 'In queue' : 'Returned') %>
              </span>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="small-note mt-3 mb-3">You have not queued any events for a venue yet. Register your event details and size to enter the assignment queue.</p>
      <% } %>
      <div class="d-grid gap-2 mt-auto">
        <a class="btn btn-primary w-100" href="/faculty/events/new">+ Register new event <%- include('partials/icon',{name:'arrow'}) %></a>
        <a class="btn btn-outline-primary w-100" href="/faculty">Access registrations &amp; queue</a>
      </div>
    </section>
  <% } else { %>
    <section class="panel campus-pass-panel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MY CAMPUS PASS</p>
          <h2>Ready for entry.</h2>
        </div>
        <span class="status status-green"><span class="status-dot" aria-hidden="true"></span> Verified</span>
      </div>
      <div class="pass-badge-card">
        <div class="pass-qr-art" aria-hidden="true">
          <div class="pass-qr-corner"></div>
          <div class="pass-qr-corner"></div>
          <div class="pass-qr-center"><%- include('partials/icon',{name:'shield'}) %></div>
          <div class="pass-qr-corner"></div>
          <span class="pass-qr-code"><%= user.student_id || 'PASS' %></span>
        </div>
        <div>
          <strong class="d-block"><%= user.name %></strong>
          <small class="muted"><%= user.student_id ? `Student ID: ${user.student_id}` : user.email %></small>
          <p class="small-note mt-2 mb-0">Present your university ID or pass at campus auditorium entrances.</p>
        </div>
      </div>

      <% if (myRegistrations && myRegistrations.length) { %>
        <div class="pass-list">
          <% for (const r of myRegistrations) { %>
            <div class="pass-list-item">
              <div>
                <strong><%= r.title %></strong>
                <small><%= displayDate(r.event_date) %> · <%= r.venue_name %></small>
              </div>
              <span class="status <%= r.registration_status === 'waitlisted' ? 'status-amber' : 'status-green' %>">
                <%= r.registration_status === 'waitlisted' ? 'Waitlisted' : 'Confirmed' %>
              </span>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="small-note mt-3 mb-3">You haven’t reserved any seats yet. Browse upcoming campus events to claim your pass.</p>
      <% } %>
      <a class="btn btn-outline-primary w-100 mt-auto" href="/registrations">Manage my registrations <%- include('partials/icon',{name:'arrow'}) %></a>
    </section>
  <% } %>
</div>

<% if (isAdmin && venueUtilization && venueUtilization.length) { %>
  <section class="panel mt-4">
    <div class="section-heading">
      <div>
        <p class="eyebrow">DBMS CAPACITY ANALYTICS</p>
        <h2>Venue utilization<span class="heading-period">.</span></h2>
      </div>
      <a href="/reports?query=venue_utilization">Open full SQL report ↗</a>
    </div>
    <div class="table-responsive" tabindex="0" role="region" aria-label="Venue utilization table">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Venue</th>
            <th scope="col">Hall capacity</th>
            <th scope="col">Scheduled events</th>
            <th scope="col">Allocated seats</th>
            <th scope="col">Confirmed attendees</th>
          </tr>
        </thead>
        <tbody>
          <% for (const vu of venueUtilization) { %>
            <tr>
              <td><strong><%= vu.venue_name %></strong></td>
              <td><%= vu.capacity %></td>
              <td><%= vu.scheduled_events %></td>
              <td><%= vu.allocated_seats %></td>
              <td><%= vu.total_confirmed_attendees %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<script type="application/json" id="calendar-data"><%- JSON.stringify({ eventsByDate: calendarEvents, today, isAdmin, isFaculty }).replace(/</g, '\\u003c') %></script>
<%- include('partials/footer') %>
