<%- include('partials/header',{title:'Overview',active:'dashboard'}) %>
<section class="overview-hero"><div class="overview-copy"><p class="eyebrow"><%= user.role==='admin'?'Administrator dashboard':'Student dashboard' %></p><h1 class="split-heading"><span>Your campus.</span><span>In one <em>place.</em></span></h1><p>Welcome, <%= user.name %>. A clear view of what’s happening—and what comes next.</p><a class="btn btn-hero" href="<%= user.role==='admin'?'/events/new':'/events' %>"><%= user.role==='admin'?'+ Create event':'Browse events' %> <%- include('partials/icon',{name:'arrow'}) %></a></div><div class="overview-next"><div class="next-top"><span class="eyebrow">NEXT ON CAMPUS</span><%- include('partials/icon',{name:'calendar'}) %></div><% if(upcoming.length){ const next=upcoming[0]; %><div class="next-date"><strong><%= dateDay(next.event_date) %></strong><span><%= dateMonth(next.event_date) %></span></div><h2><%= next.title %></h2><p><%= next.venue_name %><br><%= clock(next.start_time) %>–<%= clock(next.end_time) %></p><a href="/events" class="next-link">Explore campus events <%- include('partials/icon',{name:'arrow'}) %></a><% } else { %><h2>Your next great event<br>starts here.</h2><p>No upcoming events yet.</p><a href="/events" class="next-link">Open events <%- include('partials/icon',{name:'arrow'}) %></a><% } %></div></section>
<div class="metric-grid"><% const metrics=[['Scheduled events',stats.events,'Active campus events','calendar','/events'],['Campus venues',stats.venues,'Available event halls','building','/venues'],['CPU Algorithms','2 Active','FCFS & SJF modules','cpu','/simulator'],['Database status','Connected','Relational database','lock','/reports']]; for(const m of metrics){ %><a href="<%= m[4] %>" class="panel metric text-decoration-none" style="display:block;color:inherit;"><div class="metric-top"><span><%= m[0] %></span><span class="metric-icon"><%- include('partials/icon',{name:m[3]}) %></span></div><strong><%= m[1] %></strong><small><%= m[2] %></small></a><% } %></div>

<section class="panel calendar-panel mb-4">
  <div class="section-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <p class="eyebrow">MONTHLY EVENT CALENDAR</p>
      <h2>Interactive campus schedule<span class="heading-period">.</span></h2>
      <p class="muted">Click any date to inspect scheduled events and launch the OS CPU process scheduler.</p>
    </div>
    <div class="calendar-controls d-flex align-items-center gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm" id="cal-prev">&larr; Prev</button>
      <span class="fw-bold px-2" id="cal-month-year"></span>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="cal-next">Next &rarr;</button>
    </div>
  </div>

  <div class="calendar-grid-header">
    <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
  </div>
  <div class="calendar-grid" id="calendar-days"></div>

  <div class="selected-date-card mt-3" id="selected-date-card" style="display:none;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <p class="eyebrow m-0 text-primary">SELECTED DATE</p>
        <h3 class="m-0 fs-5" id="sel-date-label"></h3>
      </div>
      <div class="d-flex gap-2 flex-wrap" id="sel-date-actions"></div>
    </div>
    <div id="sel-date-events"></div>
  </div>
</section>

<div class="dashboard-grid"><section class="panel upcoming-panel"><div class="section-heading"><div><p class="eyebrow">THE CAMPUS CALENDAR</p><h2>Coming up next.</h2></div><a href="/events">View all <span aria-hidden="true">↗</span></a></div><% for(const e of upcoming){ %><article class="event-mini"><div class="date-badge"><strong><%= dateDay(e.event_date) %></strong><span><%= dateMonth(e.event_date) %></span></div><div><h3><%= e.title %></h3><p><%= e.venue_name %> · <%= clock(e.start_time) %>–<%= clock(e.end_time) %></p><small>Capacity: <%= e.expected_attendance %> seats</small></div><a class="event-mini-link" href="/events" aria-label="Browse <%= e.title %>"><%- include('partials/icon',{name:'arrow'}) %></a></article><% } if(!upcoming.length){ %><p class="empty-state">No upcoming events yet.</p><% } %></section><section class="panel learning-panel"><div class="lab-heading"><span class="lab-symbol"><%- include('partials/icon',{name:'cpu'}) %></span><span class="eyebrow">THE OS SANDBOX</span></div><h2>Small processes.<br>Big insights.</h2><p>One workload. Two strategies. See how FCFS and non-preemptive SJF change the order—and the wait.</p><div class="lab-flow" aria-label="Simulation workflow"><span>01<br><strong>Arrive</strong></span><span aria-hidden="true">→</span><span>02<br><strong>Execute</strong></span><span aria-hidden="true">→</span><span>03<br><strong>Measure</strong></span></div><a class="btn btn-primary" href="/simulator">Open CPU simulator <%- include('partials/icon',{name:'arrow'}) %></a><div class="notice">The OS CPU scheduler sequences events without collisions and commits non-overlapping time slots to MySQL.</div></section></div>

<script>
  (function(){
    const eventsByDate = <%- JSON.stringify(calendarEvents) %>;
    const todayStr = "<%= today %>";
    const venues = <%- JSON.stringify(venues) %>;
    const defaultVenueId = venues[0]?.venue_id || 1;

    let [tYear, tMonth] = todayStr.split('-').map(Number);
    let viewYear = tYear;
    let viewMonth = tMonth - 1;

    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    const daysContainer = document.getElementById('calendar-days');
    const monthYearLabel = document.getElementById('cal-month-year');
    const selectedDateCard = document.getElementById('selected-date-card');
    const selDateLabel = document.getElementById('sel-date-label');
    const selDateActions = document.getElementById('sel-date-actions');
    const selDateEvents = document.getElementById('sel-date-events');

    function renderCalendar() {
      monthYearLabel.textContent = monthNames[viewMonth] + " " + viewYear;
      daysContainer.innerHTML = '';

      const firstDayIndex = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(viewYear, viewMonth, 0).getDate();

      for (let i = firstDayIndex - 1; i >= 0; i--) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day-cell inactive-month';
        cell.innerHTML = '<span class="calendar-day-num">' + (daysInPrevMonth - i) + '</span>';
        daysContainer.appendChild(cell);
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const dStr = String(d).padStart(2, '0');
        const mStr = String(viewMonth + 1).padStart(2, '0');
        const dateKey = viewYear + "-" + mStr + "-" + dStr;
        const dayEvents = eventsByDate[dateKey] || [];

        const cell = document.createElement('div');
        cell.className = 'calendar-day-cell';
        if (dateKey === todayStr) cell.classList.add('is-today');

        let pillsHtml = '';
        if (dayEvents.length > 0) {
          const hasPending = dayEvents.some(function(e){ return e.status === 'pending_schedule'; });
          pillsHtml = '<span class="calendar-event-pill ' + (hasPending ? 'pending' : '') + '">' +
            dayEvents.length + ' event' + (dayEvents.length > 1 ? 's' : '') +
            '</span>';
        }

        cell.innerHTML = '<span class="calendar-day-num">' + d + '</span>' + pillsHtml;

        cell.addEventListener('click', (function(k, evts){
          return function(){
            document.querySelectorAll('.calendar-day-cell').forEach(function(c){ c.classList.remove('is-selected'); });
            cell.classList.add('is-selected');
            selectDate(k, evts);
          };
        })(dateKey, dayEvents));

        daysContainer.appendChild(cell);
      }
    }

    function selectDate(dateKey, dayEvents) {
      selectedDateCard.style.display = 'block';
      selDateLabel.textContent = new Date(dateKey + 'T00:00:00').toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

      const venueId = (dayEvents && dayEvents[0]) ? dayEvents[0].venue_id : defaultVenueId;

      selDateActions.innerHTML = 
        '<a class="btn btn-primary btn-sm" href="/simulator?date=' + dateKey + '">⚡ Launch OS Scheduler for this Date &rarr;</a>' +
        '<a class="btn btn-outline-secondary btn-sm" href="/events/new?date=' + dateKey + '">+ Create Event</a>';

      if (!dayEvents || dayEvents.length === 0) {
        selDateEvents.innerHTML = '<p class="text-muted m-0">No events scheduled for this date. Click "+ Create Event" to add events, or launch the OS Scheduler to plan workloads.</p>';
        return;
      }

      selDateEvents.innerHTML = dayEvents.map(function(e){
        const isPending = e.status === 'pending_schedule';
        const startH = parseInt(e.start_time.split(':')[0], 10);
        const arrivalH = Math.max(0, startH - 9);
        const burstH = Math.max(1, Math.ceil(e.expected_attendance / 50));

        return '<div class="event-item-card">' +
          '<div>' +
            '<div class="d-flex align-items-center gap-2 mb-1">' +
              '<strong>' + e.title + '</strong>' +
              '<span class="status ' + (isPending ? 'status-amber' : 'status-green') + '">' + (isPending ? 'Pending OS' : 'Scheduled') + '</span>' +
            '</div>' +
            '<small class="text-muted">' +
              '📍 ' + e.venue_name + ' · ⏰ Requested: ' + e.start_time.slice(0,5) + '–' + e.end_time.slice(0,5) + ' · 👥 ' + e.expected_attendance + ' students' +
            '</small>' +
          '</div>' +
          '<div class="text-end">' +
            '<span class="badge bg-light text-dark border me-1">AT = ' + arrivalH + 'h</span>' +
            '<span class="badge bg-light text-dark border">BT = ' + burstH + 'h</span>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    document.getElementById('cal-prev').addEventListener('click', function(){
      viewMonth--;
      if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      renderCalendar();
    });

    document.getElementById('cal-next').addEventListener('click', function(){
      viewMonth++;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      renderCalendar();
    });

    renderCalendar();

    const eventDates = Object.keys(eventsByDate);
    const targetDate = eventDates[0] || todayStr;
    const targetEvents = eventsByDate[targetDate] || [];
    selectDate(targetDate, targetEvents);
  })();
</script>
<%- include('partials/footer') %>