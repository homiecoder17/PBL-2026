<%- include('partials/header',{title:'Event editor',active:'events'}) %>
<div class="page-heading"><div><p class="eyebrow">EVENT MANAGEMENT</p><h1><%= editing?'Edit':'Create' %> event</h1><p class="muted">Your venue, capacity, and time slot are validated in one transaction.</p></div><a class="btn btn-outline-secondary" href="/events">Back to events</a></div><form method="post" class="panel form-panel"><input type="hidden" name="csrf_token" value="<%= csrf %>"><div class="row g-4"><div class="col-12"><label class="form-label" for="title">Event title</label><input class="form-control" id="title" name="title" required maxlength="150" value="<%= event.title||'' %>" placeholder="e.g. Innovation & Research Symposium"></div><div class="col-12"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" required maxlength="5000" rows="3"><%= event.description||'' %></textarea></div><div class="col-md-4"><label class="form-label" for="event_date">Date</label><input class="form-control" id="event_date" name="event_date" type="date" required min="<%= today %>" value="<%= event.event_date||'' %>"></div><div class="col-md-4"><label class="form-label" for="start_time">Start time</label><input class="form-control" id="start_time" name="start_time" type="time" required value="<%= clock(event.start_time) %>"></div><div class="col-md-4"><label class="form-label" for="end_time">End time</label><input class="form-control" id="end_time" name="end_time" type="time" required value="<%= clock(event.end_time) %>"></div><div class="col-md-6"><div class="d-flex justify-content-between align-items-center mb-1"><label class="form-label mb-0" for="venue_id">Venue</label><a href="/venues/new" class="small-note text-primary">+ Add new venue</a></div><select class="form-select" id="venue_id" name="venue_id" required><option value="">Select a venue</option><% for(const v of venues){ %><option value="<%= v.venue_id %>" <%= String(event.venue_id)===String(v.venue_id)?'selected':'' %>><%= v.venue_name %> · capacity <%= v.capacity %></option><% } %></select></div><div class="col-md-6"><label class="form-label" for="expected_attendance">Expected attendance / registration limit</label><input class="form-control" id="expected_attendance" name="expected_attendance" type="number" min="1" max="1000000" required value="<%= event.expected_attendance||'' %>"></div><div class="col-md-6"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="pending_schedule" <%= (!event.status || event.status==='pending_schedule')?'selected':'' %>>Pending Scheduling (OS Scheduler will sequence)</option><option value="scheduled" <%= event.status==='scheduled'?'selected':'' %>>Scheduled (Fixed time slot)</option><option value="cancelled" <%= event.status==='cancelled'?'selected':'' %>>Cancelled</option></select></div><div class="col-12"><div class="notice"><strong>OS Scheduling Integration:</strong> Start time is assigned as <em>Arrival Time</em> (offset from 09:00 AM) and expected attendance determines <em>Burst Time</em> (50 students/hr). Set to <strong>Pending Scheduling</strong> to let the OS CPU scheduler allocate non-conflicting slots for your day.</div></div><div class="col-12"><button class="btn btn-primary"><%= editing?'Save changes':'Create event' %></button></div></div></form>
<%- include('partials/footer') %>