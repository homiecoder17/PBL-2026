<%- include('partials/header',{title:'OS Scheduler',active:'simulator'}) %>
<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION · SCHEDULING DISPATCH</p>
    <h1>OS Schedule Simulator<span class="heading-period">.</span></h1>
    <p class="muted">Compare dispatch strategies (FCFS, SJF, SRTF, Priority, Round Robin), analyze timeline metrics, and commit optimal time slots.</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="status status-green"><span class="status-dot" aria-hidden="true"></span> Deterministic Engine</span>
  </div>
</div>

<% if(dayEvents && dayEvents.length){ %>
  <div class="panel d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 py-3 px-3 border-start border-4 border-primary">
    <div class="d-flex align-items-center gap-2">
      <span class="fs-5">📅</span>
      <span>
        Found <strong><%= dayEvents.length %></strong> event(s) for <strong><%= selectedDate %></strong>
        <% if(selectedVenueId && selectedVenueId !== 'all'){ %>
          at <strong><%= venues.find(v => String(v.venue_id) === String(selectedVenueId))?.venue_name %></strong>
        <% } else { %>
          across all venues
        <% } %> · auto-mapped into process workloads.
      </span>
    </div>
    <a class="btn btn-sm btn-outline-primary" href="/events/new?date=<%= selectedDate %>">+ Add event</a>
  </div>
<% } %>

<div class="panel mb-4">
  <form method="post" id="simulator-form">
    <input type="hidden" name="csrf_token" value="<%= csrf %>">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <div>
        <h2 class="h5 mb-0">Schedule Parameters &amp; Workload</h2>
        <p class="small-note text-muted mb-0">Select a date and hall to benchmark scheduling algorithms.</p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small-note text-muted">Quick dates:</span>
        <a href="/simulator?date=<%= today %>&venue_id=<%= selectedVenueId %>&quantum=<%= quantum %>" class="btn btn-sm <%= selectedDate===today ? 'btn-primary' : 'btn-outline-secondary' %>">Today</a>
        <a href="/simulator?date=<%= tomorrow %>&venue_id=<%= selectedVenueId %>&quantum=<%= quantum %>" class="btn btn-sm <%= selectedDate===tomorrow ? 'btn-primary' : 'btn-outline-secondary' %>">Tomorrow</a>
        <a href="/simulator?date=<%= dayAfterTomorrow %>&venue_id=<%= selectedVenueId %>&quantum=<%= quantum %>" class="btn btn-sm <%= selectedDate===dayAfterTomorrow ? 'btn-primary' : 'btn-outline-secondary' %>">Day After</a>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label" for="event_date">Selected date</label>
        <input class="form-control" type="date" id="event_date" name="event_date" required min="<%= minDate %>" value="<%= selectedDate %>" data-auto-filter>
      </div>
      <div class="col-md-5">
        <label class="form-label" for="venue_id">Target venue</label>
        <select class="form-select" id="venue_id" name="venue_id" data-auto-filter>
          <option value="all" <%= selectedVenueId==='all'?'selected':'' %>>All Venues (All events of <%= selectedDate %>)</option>
          <% for(const v of venues){ %>
            <option value="<%= v.venue_id %>" <%= String(v.venue_id)===String(selectedVenueId)?'selected':'' %>><%= v.venue_name %> (Cap: <%= v.capacity %>)</option>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="quantum">Round Robin Quantum (q)</label>
        <input class="form-control" type="number" id="quantum" name="quantum" min="1" max="1000" required value="<%= quantum %>">
      </div>
    </div>

    <% if(dayEvents && dayEvents.length > 0){ %>
      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label class="form-label mb-0 fw-semibold">Mapped Campus Events (<%= dayEvents.length %>)</label>
          <span class="small-note text-muted">Arrival (AT) = Start &minus; 9 AM · Burst (BT) = ceil(Seats / 50)</span>
        </div>
        <div class="table-responsive border rounded" style="max-height: 200px; overflow-y: auto;">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" style="width: 60px;">PID</th>
                <th scope="col">Event Title</th>
                <th scope="col">Venue</th>
                <th scope="col">Start &rarr; AT</th>
                <th scope="col">Seats &rarr; BT</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              <% dayEvents.forEach((ev, idx) => { 
                   const at = Math.max(0, parseInt(ev.start_time.split(':')[0], 10) - 9);
                   const bt = Math.max(1, Math.ceil(ev.expected_attendance / 50));
              %>
              <tr>
                <td><span class="badge bg-secondary font-mono">E<%= idx + 1 %></span></td>
                <td><strong><%= ev.title %></strong></td>
                <td><span class="small-note"><%= ev.venue_name || 'Auditorium' %></span></td>
                <td class="font-mono"><%= ev.start_time.slice(0, 5) %> <small class="text-muted">(AT=<%= at %>h)</small></td>
                <td class="font-mono"><%= ev.expected_attendance %> <small class="text-muted">(BT=<%= bt %>h)</small></td>
                <td>
                  <% if(ev.status === 'pending_schedule'){ %>
                    <span class="status status-amber">Pending OS</span>
                  <% } else { %>
                    <span class="status status-green">Scheduled</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="p-3 mb-3 border rounded text-center bg-light-subtle">
        <p class="mb-2 text-muted small">No scheduled events found for <%= selectedDate %>.</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
          <a class="btn btn-sm btn-primary" href="/events/new?date=<%= selectedDate %>">+ Create event for date</a>
          <button type="submit" name="load_samples" value="true" class="btn btn-sm btn-outline-secondary">Load sample workload</button>
        </div>
      </div>
    <% } %>

    <div class="d-flex gap-2 flex-wrap align-items-center pt-2">
      <button class="btn btn-primary" type="submit">Run schedule comparison</button>
      <a class="btn btn-outline-secondary" href="/events/new?date=<%= selectedDate %>">+ Add event</a>
      <a class="btn btn-outline-secondary" href="/simulator?date=<%= selectedDate %>&reset=1&quantum=<%= quantum %>">Reset</a>
    </div>

    <details class="mt-3 pt-2 border-top">
      <summary class="small-note text-muted" style="cursor: pointer; user-select: none;">🛠 Advanced: View / edit raw process CSV workload</summary>
      <div class="mt-2">
        <textarea class="form-control workload-input font-mono" id="processes" name="processes" rows="3" style="min-height: 90px;"><%= source %></textarea>
        <p class="small-note mt-1 mb-0 text-muted">Format: <code>process_id, title, arrival_or_HH:MM, burst_or_students[, priority]</code></p>
      </div>
    </details>
  </form>
</div>

<% if(results.length){ %>
  <section class="panel mb-4">
    <div class="section-heading mb-3">
      <div>
        <p class="eyebrow">5-ALGORITHM BENCHMARK MATRIX</p>
        <h2 class="mb-0">Comparative Performance<span class="heading-period">.</span></h2>
      </div>
      <% if (bestAlgorithm) { %>
        <span class="status status-green"><span class="status-dot" aria-hidden="true"></span> Lowest waiting time: <%= bestAlgorithm %></span>
      <% } %>
    </div>

    <div class="alg-matrix-grid mb-4">
      <% for (const r of results) {
           const isBest = r.algorithm === bestAlgorithm;
           const isPreemptive = r.algorithm === 'SRTF' || r.algorithm === 'RR';
      %>
        <article class="alg-card <%= isBest ? 'alg-card-best is-selected' : '' %>" data-alg-card="<%= r.algorithm %>" role="button" tabindex="0" title="Click to view <%= r.algorithm %> details">
          <% if (isBest) { %><span class="alg-ribbon">Optimal WT</span><% } %>
          <div class="alg-card-head">
            <strong><%= r.algorithm %><%= r.algorithm === 'RR' ? ` (q=${r.quantum})` : '' %></strong>
            <span class="status <%= isPreemptive ? 'status-amber' : 'status-gray' %>"><%= isPreemptive ? 'Preemptive' : 'Non-preemptive' %></span>
          </div>
          <dl class="alg-stats">
            <div><dt>Avg Wait</dt><dd><strong><%= fixed(r.average_waiting_time) %></strong> u</dd></div>
            <div><dt>Avg Turnaround</dt><dd><%= fixed(r.average_turnaround_time) %> u</dd></div>
            <div><dt>Throughput</dt><dd><%= fixed(r.throughput) %>/u</dd></div>
          </dl>
          <div class="alg-util">
            <div class="alg-util-head"><span>CPU Efficiency</span><strong><%= fixed(r.cpu_utilization) %>%</strong></div>
            <div class="capacity-track"><span style="width:<%= Math.min(100, Math.round(r.cpu_utilization)) %>%"></span></div>
          </div>
        </article>
      <% } %>
    </div>

    <div class="alg-tab-bar d-flex gap-2 flex-wrap align-items-center p-2 rounded border bg-light-subtle" role="tablist" aria-label="Algorithm tabs">
      <span class="small-note fw-semibold text-muted px-1">Selected View:</span>
      <% for (const r of results) {
           const isBest = r.algorithm === bestAlgorithm;
      %>
        <button type="button" class="btn btn-sm <%= isBest ? 'btn-primary' : 'btn-outline-secondary' %> alg-tab-btn" data-alg-target="<%= r.algorithm %>">
          <% if (isBest) { %>⭐ <% } %><%= r.algorithm %><%= r.algorithm === 'RR' ? ` (q=${r.quantum})` : '' %>
        </button>
      <% } %>
      <button type="button" class="btn btn-sm btn-outline-secondary alg-tab-btn" data-alg-target="all">Show All 5</button>
    </div>
  </section>

  <div class="alg-results-container">
    <% for(const result of results){ %>
      <%- include('partials/result',{result, source, selectedVenueId, selectedDate, signedTokens, nonPreemptiveAlgs}) %>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
