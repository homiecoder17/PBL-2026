<%- include('partials/header',{title:'User directory',active:'users'}) %>
<div class="page-heading">
  <div>
    <p class="eyebrow">ACCESS &amp; IDENTITY MANAGEMENT</p>
    <h1>Campus users<span class="heading-period">.</span></h1>
    <p class="muted">Provision student and administrator accounts securely using salted scrypt password hashes.</p>
  </div>
</div>

<div class="simulator-input-grid">
  <section class="panel">
    <h2>Registered accounts (<%= users.length %>)</h2>
    <p class="table-scroll-hint">Scroll horizontally to view all columns.</p>
    <div class="table-responsive" tabindex="0" role="region" aria-label="Campus users table">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Student ID</th>
            <th scope="col">Role</th>
            <th scope="col">Registrations</th>
            <th scope="col">Saved runs</th>
          </tr>
        </thead>
        <tbody>
          <% for (const u of users) { %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td><%= u.email %></td>
              <td><%= u.student_id || '—' %></td>
              <td><span class="status <%= u.role === 'admin' ? 'status-green' : 'status-gray' %>"><%= u.role %></span></td>
              <td><%= u.registration_count %></td>
              <td><%= u.run_count %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <form method="post" class="panel form-panel">
    <input type="hidden" name="csrf_token" value="<%= csrf %>">
    <h2>Provision new account</h2>
    <p class="small-note mb-3">Passwords must be 12–256 characters and are hashed asynchronously via salted scrypt.</p>

    <div class="mb-3">
      <label class="form-label" for="name">Full name</label>
      <input class="form-control" id="name" name="name" required maxlength="100" value="<%= form.name || '' %>" placeholder="e.g. Aarav Verma">
    </div>
    <div class="mb-3">
      <label class="form-label" for="email">Email address</label>
      <input class="form-control" id="email" name="email" type="email" required maxlength="254" value="<%= form.email || '' %>" placeholder="student@campus.test">
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="form-label" for="role">Role</label>
        <select class="form-select" id="role" name="role">
          <option value="student" <%= form.role !== 'admin' ? 'selected' : '' %>>Student</option>
          <option value="admin" <%= form.role === 'admin' ? 'selected' : '' %>>Administrator</option>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="student_id">Student ID (optional for admin)</label>
        <input class="form-control" id="student_id" name="student_id" maxlength="32" value="<%= form.student_id || '' %>" placeholder="e.g. CSE2026002">
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label" for="password">Initial password (12+ chars)</label>
      <div class="password-field">
        <input class="form-control" id="password" name="password" type="password" required minlength="12" maxlength="256" autocomplete="new-password">
        <button type="button" class="password-toggle" hidden data-enhance aria-label="Show password" aria-pressed="false"><%- include('partials/icon',{name:'eye'}) %></button>
      </div>
    </div>
    <button class="btn btn-primary w-100">Create account</button>
  </form>
</div>
<%- include('partials/footer') %>
