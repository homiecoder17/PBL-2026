<%- include('partials/header',{title:'Reports & analytics',active:'reports'}) %>
<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION · SYSTEM REPORTS</p>
    <h1>Campus reports &amp; analytics<span class="heading-period">.</span></h1>
    <p class="muted">Real-time attendance summaries, venue capacity utilization, registration rosters, and scheduling audit logs.</p>
  </div>
</div>

<form method="get" class="panel report-selector">
  <label for="query" class="form-label">Select report</label>
  <div class="report-select-row">
    <select name="query" id="query" class="form-select">
      <% for (const [key, info] of Object.entries(reports)) { %>
        <option value="<%= key %>" <%= key === selected ? 'selected' : '' %>><%= info.title %></option>
      <% } %>
    </select>
    <button class="btn btn-primary">Generate report</button>
  </div>
</form>

<section class="panel">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h2 class="mb-0"><%= report.title %></h2>
      <p class="small-note text-muted mb-0"><%= rows.length %> record(s) found in database</p>
    </div>
    <span class="status status-green"><span class="status-dot" aria-hidden="true"></span> Live data</span>
  </div>

  <p class="table-scroll-hint">Scroll horizontally to view all columns.</p>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Scrollable data table">
    <table class="table">
      <caption><%= rows.length %> record(s) returned from database.</caption>
      <% if (rows.length) { %>
        <thead>
          <tr>
            <% for (const column of columns) { %>
              <th scope="col"><%= column.replaceAll('_', ' ') %></th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% for (const row of rows) { %>
            <tr>
              <% for (const column of columns) { %>
                <td><%= row[column] %></td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      <% } else { %>
        <tbody><tr><td class="empty-state">No records returned.</td></tr></tbody>
      <% } %>
    </table>
  </div>

  <details class="advanced-sql-toggle mt-4 pt-3 border-top" <%= explain ? 'open' : '' %>>
    <summary class="small-note text-muted" style="cursor: pointer; user-select: none;">🛠 Advanced: View SQL query <%= explain ? '& execution analysis' : '' %></summary>
    <div class="mt-3">
      <pre class="sql-block"><code><%= report.sql %></code></pre>

      <% if (explain && explainRows.length) { %>
        <h3 class="mt-3 mb-2 h6">Query execution plan (<code><%= dbFallback ? 'SQLite EXPLAIN QUERY PLAN' : 'MySQL EXPLAIN' %></code>)</h3>
        <div class="table-responsive mb-2" tabindex="0" role="region" aria-label="Query execution plan table">
          <table class="table table-sm">
            <thead>
              <tr>
                <% for (const col of explainColumns) { %>
                  <th scope="col"><%= col %></th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% for (const er of explainRows) { %>
                <tr>
                  <% for (const col of explainColumns) { %>
                    <td><%= er[col] %></td>
                  <% } %>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="mt-2">
          <a class="btn btn-sm btn-outline-secondary" href="/reports?query=<%= encodeURIComponent(selected) %>&explain=1">Run execution plan analysis</a>
        </div>
      <% } %>
    </div>
  </details>
</section>
<%- include('partials/footer') %>
