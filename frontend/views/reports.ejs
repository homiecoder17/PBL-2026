<%- include('partials/header',{title:'DBMS portal',active:'reports'}) %>
<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION · RELATIONAL DATABASE LAB</p>
    <h1>DBMS Portal<span class="heading-period">.</span></h1>
    <p class="muted">Interactive relational database query explorer demonstrating simple SQL queries, table joins, aggregations, and query plans.</p>
  </div>
  <span class="status status-green"><span class="status-dot" aria-hidden="true"></span> Live Database</span>
</div>

<form method="get" class="panel report-selector mb-4">
  <div class="row g-3 align-items-end">
    <div class="col-md-7">
      <label for="query" class="form-label fw-semibold">Select simple SQL query</label>
      <select name="query" id="query" class="form-select">
        <% for (const [key, info] of Object.entries(reports)) { %>
          <option value="<%= key %>" <%= key === selected ? 'selected' : '' %>><%= info.title %></option>
        <% } %>
      </select>
    </div>
    <div class="col-md-3">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="explain" name="explain" value="1" <%= explain ? 'checked' : '' %>>
        <label class="form-check-label small-note" for="explain">Show <code><%= dbFallback ? 'EXPLAIN' : 'EXPLAIN' %></code> execution plan</label>
      </div>
    </div>
    <div class="col-md-2">
      <button class="btn btn-primary w-100">Run query</button>
    </div>
  </div>
</form>

<section class="panel mb-4">
  <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <h2 class="h5 mb-0"><%= report.title %></h2>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono">SQL</span>
    </div>
    <span class="small-note text-muted font-mono"><%= rows.length %> record(s) returned</span>
  </div>

  <div class="mb-3">
    <label class="form-label small-note text-muted mb-1">Executed SQL query:</label>
    <pre class="sql-block p-3 rounded mb-0"><code><%= report.sql %></code></pre>
  </div>

  <% if (explain && explainRows.length) { %>
    <div class="mb-4 pt-3 border-top">
      <h3 class="h6 mb-2">Query execution plan (<code><%= dbFallback ? 'SQLite EXPLAIN QUERY PLAN' : 'MySQL EXPLAIN' %></code>)</h3>
      <div class="table-responsive mb-2" tabindex="0" role="region" aria-label="Query execution plan table">
        <table class="table table-sm">
          <thead>
            <tr>
              <% for (const col of explainColumns) { %>
                <th scope="col"><%= col %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% for (const er of explainRows) { %>
              <tr>
                <% for (const col of explainColumns) { %>
                  <td><%= er[col] %></td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <div class="pt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <label class="form-label small-note text-muted mb-0">Query result table:</label>
      <p class="table-scroll-hint mb-0 small-note">Scroll horizontally if table extends.</p>
    </div>

    <div class="table-responsive border rounded" tabindex="0" role="region" aria-label="Scrollable data table">
      <table class="table align-middle mb-0">
        <caption><%= rows.length %> record(s) returned from database.</caption>
        <% if (rows.length) { %>
          <thead class="table-light">
            <tr>
              <% for (const column of columns) { %>
                <th scope="col"><%= column.replaceAll('_', ' ') %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% for (const row of rows) { %>
              <tr>
                <% for (const column of columns) { %>
                  <td><%= row[column] %></td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        <% } else { %>
          <tbody><tr><td class="empty-state text-center p-4 text-muted">No records found matching query.</td></tr></tbody>
        <% } %>
      </table>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
