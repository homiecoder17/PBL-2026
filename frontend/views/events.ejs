<%- include('partials/header',{title:'Events',active:'events'}) %>
<div class="page-heading"><div><p class="eyebrow">CALENDAR MANAGEMENT</p><h1>Campus events<span class="heading-period">.</span></h1><p class="muted">Campus time zone: <%= config.campusTimezone %>. Adjacent slots are allowed; overlapping venue bookings are sequenced via the OS Scheduler.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/simulator">⚡ Open OS Scheduler</a><% if(user.role==='admin'){ %><a class="btn btn-primary" href="/events/new">+ Create event</a><% } %></div></div><div class="events-toolbar" hidden data-enhance><div class="event-search"><%- include('partials/icon',{name:'search'}) %><label class="visually-hidden" for="event-search">Search events</label><input id="event-search" type="search" placeholder="Search campus events" autocomplete="off"></div><span class="small-note" id="event-count" aria-live="polite"><%= events.length %> events</span></div><p class="search-empty panel" hidden>No matching events. Try a different search.</p><div class="event-grid"><% for(const e of events){ %><article class="panel event-card" data-event-card><span class="event-card-symbol"><%- include('partials/icon',{name:'calendar'}) %></span><div class="section-heading"><p class="eyebrow"><%= displayDate(e.event_date) %></p><span class="status <%= e.status==='scheduled'?'status-green':(e.status==='pending_schedule'?'status-amber':'status-gray') %>"><%= e.status==='pending_schedule'?'Pending OS':e.status %></span></div><h2><%= e.title %></h2><p class="description"><%= e.description %></p><dl class="event-details"><div><dt>Venue</dt><dd><%= e.venue_name %></dd></div><div><dt>Time</dt><dd><%= clock(e.start_time) %>–<%= clock(e.end_time) %></dd></div><div><dt>Organizer</dt><dd><%= e.organizer %></dd></div><div><dt>Expected</dt><dd><%= e.expected_attendance %> attendees</dd></div></dl><div class="card-actions"><a class="btn btn-outline-secondary" href="/simulator?date=<%= e.event_date %>">⚡ OS Schedule</a><% if(user.role==='admin'){ %><a class="btn btn-outline-primary" href="/events/<%= e.event_id %>/edit">Edit</a><form method="post" action="/events/<%= e.event_id %>/delete" data-confirm="Delete this event? This cannot be undone."><input type="hidden" name="csrf_token" value="<%= csrf %>"><button class="btn btn-outline-danger">Delete</button></form><% } else { %><span class="status status-green"><%= e.status==='scheduled'?'Scheduled event':'Event '+e.status %></span><% } %></div></article><% } if(!events.length){ %><section class="panel empty-state">No events have been created yet.</section><% } %></div>
<%- include('partials/footer') %>